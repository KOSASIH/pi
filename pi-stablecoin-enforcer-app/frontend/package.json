{
  "name": "pi-coin-enforcer-super-app",
  "version": "1.0.0",
  "description": "Hyper-Tech Super App for Pi Coin Stablecoin Enforcement on Stellar Network",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && surge build pi-coin-enforcer.surge.sh",
    "lint": "eslint src --ext .js,.jsx",
    "evolve": "node scripts/evolve.js"  // Autonomous evolution script
  },
  "dependencies": {
    "@stellar/freighter-api": "^1.4.0",  // Freighter wallet integration for Stellar
    "@stellar/stellar-sdk": "^10.4.0",  // Stellar SDK for network interactions
    "@soroban-react/contracts": "^0.5.0",  // Soroban contract integration
    "axios": "^1.4.0",  // API calls to backend AI
    "ethers": "^6.6.0",  // Ethereum compatibility (for Base fallback)
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "web3": "^1.9.0",  // Web3 integration
    "styled-components": "^6.0.0",  // For hyper UI styling
    "react-router-dom": "^6.14.0",  // Routing for multi-page app
    "react-redux": "^8.1.0",  // State management for enforcement data
    "@reduxjs/toolkit": "^1.9.5",
    "react-chartjs-2": "^5.2.0",  // Charts for compliance dashboard
    "chart.js": "^4.3.0",
    "crypto-js": "^4.1.1"  // For quantum-resistant hashing simulations
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "surge": "^0.23.1"  // Deploy tool
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "pi-coin",
    "stablecoin",
    "stellar",
    "soroban",
    "ai-enforcement",
    "quantum-security",
    "zero-trust",
    "compliance",
    "hyper-tech"
  ],
  "author": "KOSASIH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KOSASIH/pi-stablecoin-enforcer-app"
  },
  "homepage": "https://pi-coin-enforcer.surge.sh",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://localhost:5000",  // Proxy to backend API
  "notes": {
    "quantum-security": "Uses crypto-js for SHA3 simulations; integrate real quantum libs for production",
    "autonomous-evolution": "Run 'npm run evolve' to trigger AI/RL updates from backend",
    "stellar-integration": "Freighter wallet required for Stellar testnet interactions",
    "compliance": "Badges update autonomously via API; ensure IOSCO/ILO scores are real"
  }
}
