# Quantum Nexus AI API Dockerfile - Ultimate Hyper-Tech Containerization
# Multi-stage build for optimized, secure, and efficient API container.

# Stage 1: Builder - Install dependencies and build
FROM python:3.9-slim AS builder

# Set environment variables for Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies for quantum/AI libs
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements and install Python deps
COPY requirements.txt .
RUN pip install --user -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY config/ ./config/

# Stage 2: Runtime - Lightweight production image
FROM python:3.9-slim AS runtime

# Install runtime dependencies (minimal)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash quantum
USER quantum

# Set environment
ENV PATH="/home/quantum/.local/bin:$PATH" \
    PYTHONPATH="/app"

# Set work directory
WORKDIR /app

# Copy installed packages from builder
COPY --from=builder --chown=quantum:quantum /home/quantum/.local /home/quantum/.local

# Copy application code
COPY --chown=quantum:quantum src/ ./src/
COPY --chown=quantum:quantum config/ ./config/

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the API
CMD ["uvicorn", "src.api.fastapi_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
